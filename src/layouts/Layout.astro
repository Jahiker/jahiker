---
// spec: specs/02-astro-i18n-layout.md, specs/03-accessibility-mode.md, specs/17-pages-assembly.md, specs/18-seo-sitemap-qa.md, specs/p2-01-dark-light-mode.md
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const {
  title,
  description = "Fullstack Developer building fast, beautiful web experiences.",
  lang = "en",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteOrigin = (Astro.site?.href ?? 'https://jahiker.github.io').replace(/\/$/, '')

// spec: specs/02-astro-i18n-layout.md (v1.2 FR-01) — explicit `/` after BASE_URL (no trailing slash in Astro 4.15.8)
const canonicalUrl = Astro.url.href
const enUrl  = `${siteOrigin}${base}/`
const esUrl  = `${siteOrigin}${base}/es/`
const ogImage = `${siteOrigin}${base}/images/avatar.jpeg`
---

<!doctype html>
<html lang={lang} class="scroll-smooth lg:scroll-pt-16">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang alternates -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:locale"      content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:site_name"   content="Jahiker Rojas" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Favicon (single SVG with embedded dark/light CSS) -->
    <!-- fix: specs/fixes/favicon-double-slash-regression.md — BASE_URL has no trailing slash in Astro 4.15.8; explicit `/` required -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <!-- Theme color -->
    <meta name="theme-color" content="#1e1e1e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#e7e7d8" media="(prefers-color-scheme: light)" />


    <!-- A11y + Theme: restore from localStorage before first paint to prevent flash -->
    <script is:inline>
      try {
        // spec 03 — a11y mode restore
        if (localStorage.getItem('A11Y_V1') === 'true') {
          document.documentElement.setAttribute('data-a11y', 'true');
        }
        // spec p2-01 — theme restore (localStorage wins; falls back to OS preference; else dark default)
        var storedTheme = localStorage.getItem('THEME_V1');
        if (storedTheme === 'light' || storedTheme === 'dark') {
          document.documentElement.setAttribute('data-theme', storedTheme);
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      } catch (_) {}
    </script>
  </head>
  <body class="bg-bg">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
