---
// spec: specs/00-project-cleanup.md, specs/02-astro-i18n-layout.md
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const {
  title,
  description = "Fullstack Developer building fast, beautiful web experiences.",
  lang = "en",
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}logo.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <!-- A11y: restore high-contrast mode before first paint to prevent flash -->
    <script is:inline>
      try {
        if (localStorage.getItem('A11Y_V1') === 'true') {
          document.documentElement.setAttribute('data-a11y', 'true');
        }
      } catch (_) {}
    </script>
  </head>
  <body class="bg-black">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
