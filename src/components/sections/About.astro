---
// spec: specs/12-about-section.md
import { content as contentEn } from '../../data/en/content'
import { content as contentEs } from '../../data/es/content'
import avatarSrc from '../../images/avatar.jpeg'

const locale = Astro.currentLocale ?? 'en'
const { about } = locale === 'es' ? contentEs : contentEn

const heading = locale === 'es' ? 'Sobre mí' : 'About me'
const stats = [
  { value: '5+', label: locale === 'es' ? 'Años de experiencia' : 'Years of experience' },
  { value: 'Fullstack', label: locale === 'es' ? 'Frontend & Backend' : 'Frontend & Backend' },
  { value: 'Ing.', label: locale === 'es' ? 'Ingeniero Industrial' : 'Industrial Engineer' },
]
---

<!-- Section heading -->
<section id="about" class="border-b border-white/20">
  <div class="mx-auto max-w-7xl border-x border-white/20">

    <div class="px-8 py-6 border-b border-white/20 gradient-grid">
      <h2 class="font-display text-white text-3xl uppercase">{heading}</h2>
    </div>

    <!-- Content -->
    <div class="flex flex-col lg:flex-row lg:items-stretch">

      <!-- Bio + stats -->
      <div class="flex flex-col flex-1 border-b border-white/20 lg:border-b-0 lg:border-r">

        <!-- Bio text -->
        <div class="px-8 py-10 flex-1">
          <p class="font-display text-white/70 text-lg lg:text-xl uppercase leading-relaxed">
            {about.text}
          </p>
        </div>

        <!-- Stats row -->
        <div class="overflow-x-auto border-t border-white/20 [&::-webkit-scrollbar]:hidden [scrollbar-width:none] [-ms-overflow-style:none]">
          <div class="flex min-w-max lg:min-w-0">
            {stats.map((stat, i) => (
              <div class:list={[
                'px-6 py-6 flex flex-col gap-1 min-w-[140px] lg:min-w-0 lg:flex-1',
                i < stats.length - 1 ? 'border-r border-white/20' : '',
              ]}>
                <span class="font-display text-primary text-2xl lg:text-3xl uppercase">{stat.value}</span>
                <span class="font-display text-white/40 text-xs uppercase">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- Avatar -->
      <div class="lg:w-80 xl:w-96 flex items-center justify-center p-10 lg:p-12">
        <div class="relative">
          <div class="absolute -inset-2 rounded-full bg-primary/20 blur-xl"></div>
          <img
            src={avatarSrc.src}
            alt="Jahiker Rojas"
            width="280"
            height="280"
            class="relative w-48 h-48 lg:w-64 lg:h-64 rounded-full object-cover ring-2 ring-primary/60"
          />
        </div>
      </div>

    </div>
  </div>
</section>
