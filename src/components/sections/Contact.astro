---
// spec: specs/16-contact-section.md
import { content as contentEn } from '../../data/en/content'
import { content as contentEs } from '../../data/es/content'

const locale = Astro.currentLocale ?? 'en'
const { contact } = locale === 'es' ? contentEs : contentEn

const subheading = locale === 'es'
  ? 'Disponible para proyectos freelance y oportunidades fulltime.'
  : 'Available for freelance projects.'
---

<section id="contact" class="border-b border-white/20">
  <div class="mx-auto max-w-7xl border-x border-white/20">

    <!-- Main CTA area -->
    <div class="gradient-grid px-8 py-16 lg:py-24 flex flex-col items-start gap-8 border-b border-white/20">

      <!-- Heading -->
      <div class="flex flex-col gap-3">
        <h2 class="font-display text-white uppercase text-4xl lg:text-7xl xl:text-8xl leading-none">
          {contact.heading}
        </h2>
        <p class="font-display text-white/40 text-sm lg:text-base uppercase">
          {subheading}
        </p>
      </div>

      <!-- Email CTA -->
      <a
        href={`mailto:${contact.email}`}
        class="font-display text-primary hover:text-white text-xl lg:text-3xl uppercase transition-colors duration-200 inline-flex items-center gap-3 group"
      >
        {contact.email}
        <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform duration-200">&rarr;</span>
      </a>

      <!-- Secondary links -->
      <div class="flex flex-wrap gap-3">
        <a
          href={`https://linkedin.com/in/${contact.linkedin}`}
          target="_blank"
          rel="noopener noreferrer"
          class="font-display text-xs uppercase text-white/60 hover:text-white border border-white/20 hover:border-white/60 px-6 py-3 rounded-full transition-colors duration-200 inline-flex items-center gap-2"
        >
          LinkedIn
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={`https://github.com/${contact.github}`}
          target="_blank"
          rel="noopener noreferrer"
          class="font-display text-xs uppercase text-white/60 hover:text-white border border-white/20 hover:border-white/60 px-6 py-3 rounded-full transition-colors duration-200 inline-flex items-center gap-2"
        >
          GitHub
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

    </div>

  </div>
</section>
