---
// spec: specs/10-footer.md
import { content as contentEn } from '../../data/en/content'
import { content as contentEs } from '../../data/es/content'

const locale = Astro.currentLocale ?? 'en'
const { nav, contact } = locale === 'es' ? contentEs : contentEn
const year = new Date().getFullYear()
---

<footer class="border-t border-white/20 bg-black">
  <div class="mx-auto max-w-7xl border-x border-white/20">

    <!-- Main row -->
    <div class="flex flex-col lg:flex-row lg:items-stretch border-b border-white/20">

      <!-- Logo -->
      <div class="px-8 py-8 border-b border-white/20 lg:border-b-0 lg:border-r lg:flex lg:items-center lg:min-w-48">
        <p class="font-display text-white text-xs uppercase">
          Jahiker Rojas <span aria-hidden="true">&rarr;</span>
        </p>
      </div>

      <!-- Nav links -->
      <nav aria-label="Footer navigation" class="flex flex-wrap border-b border-white/20 lg:border-b-0 lg:border-r">
        {nav.map(link => (
          <a
            href={link.href}
            class="font-display text-white/40 hover:text-white text-xs uppercase px-6 py-5 flex items-center transition-colors duration-200 border-r border-white/10 last:border-0"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Social links -->
      <div class="flex lg:ml-auto">
        <a
          href={`mailto:${contact.email}`}
          aria-label="Send email"
          class="font-display text-white/40 hover:text-white text-xs uppercase px-6 py-5 flex items-center border-r border-white/20 transition-colors duration-200"
        >Email</a>
        <a
          href={`https://github.com/${contact.github}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          class="font-display text-white/40 hover:text-white text-xs uppercase px-6 py-5 flex items-center border-r border-white/20 transition-colors duration-200"
        >GitHub</a>
        <a
          href={`https://linkedin.com/in/${contact.linkedin}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
          class="font-display text-white/40 hover:text-white text-xs uppercase px-6 py-5 flex items-center transition-colors duration-200"
        >LinkedIn</a>
      </div>

    </div>

    <!-- Copyright -->
    <div class="px-8 py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <p class="text-white/30 text-xs font-display uppercase">
        &copy; {year} Jahiker Rojas &mdash; All rights reserved
      </p>
      <p class="text-white/20 text-xs">
        Built with <span class="text-white/40">Astro</span> &amp; <span class="text-white/40">Tailwind CSS</span>
      </p>
    </div>

  </div>
</footer>
