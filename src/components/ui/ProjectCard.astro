---
// spec: specs/14-projects-section.md
import type { Project } from '../../data/types'

interface Props {
  project: Project
  viewLabel: string
  sourceLabel: string
}

const { project, viewLabel, sourceLabel } = Astro.props
---

<article class="flex flex-col h-full border-r border-white/20 last:border-r-0">

  <!-- Image -->
  <div class="aspect-video overflow-hidden border-b border-white/20">
    <img
      src={project.image.src}
      alt={project.name}
      width={project.image.width}
      height={project.image.height}
      class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
      loading="lazy"
    />
  </div>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-6 gap-4">

    <!-- Name + year -->
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-display text-white text-sm uppercase leading-tight">{project.name}</h3>
      <span class="font-display text-white/30 text-xs shrink-0">{project.year}</span>
    </div>

    <!-- Description -->
    <p class="text-white/50 text-xs leading-relaxed line-clamp-3 flex-1">
      {project.description}
    </p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5">
      {project.tags.map(tag => (
        <span class="font-display text-white/30 text-xs uppercase border border-white/10 px-2.5 py-1 rounded-full">
          {tag}
        </span>
      ))}
    </div>

    <!-- Links -->
    <div class="flex gap-2 pt-1 border-t border-white/10">
      <a
        href={project.siteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-display text-xs uppercase text-black bg-primary hover:bg-white px-4 py-2 rounded-full transition-colors duration-200 flex items-center gap-1.5"
      >
        {viewLabel} <span aria-hidden="true">&rarr;</span>
      </a>
      {project.sourceCodeUrl && (
        <a
          href={project.sourceCodeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-display text-xs uppercase text-white/50 hover:text-white border border-white/20 hover:border-white/50 px-4 py-2 rounded-full transition-colors duration-200"
        >
          {sourceLabel}
        </a>
      )}
    </div>

  </div>
</article>
